# Device Access Project ID (UUID, not the Google Cloud project ID)
NEST_DEVICE_ACCESS_PROJECT_ID=
NEST_OAUTH_CLIENT_ID=
NEST_OAUTH_CLIENT_SECRET=
NEST_OAUTH_REFRESH_TOKEN=

# Optional. Device ID suffix or full enterprises/.../devices/... name.
NEST_DEVICE_ID=

# The thermostat is shown as the first-floor sensor by default.
NEST_STATUS_LABEL='Дом, 1 этаж'

# Optional, for example socks5h://127.0.0.1:1079
NEST_HTTPS_PROXY=
