#!/usr/bin/env bash
set -euo pipefail

status_dir=${TG_CONTROL_STATUS_DIR:-/etc/tg-server-control/status.d}
source /usr/local/lib/tg-server-control/status-common.sh

run_status_provider() {
    local provider="$1"
    shift
    if [[ -x "$provider" ]]; then
        "$provider" "$@" || printf '❌ %s\n' "$(basename "$provider")"
    fi
}

run_all_statuses() {
    local provider
    while IFS= read -r -d '' provider; do
        run_status_provider "$provider"
    done < <(find "$status_dir" -maxdepth 1 -type f -executable -print0 | sort -z)
}

water_run() {
    local period="$1"
    local unit="sonar-water-report@${period}.service"
    local alias="Отчёт · день"
    [[ "$period" == weekly ]] && alias="Отчёт · неделя"
    systemctl reset-failed "$unit" || true
    systemctl start "$unit"
    unit_icon "$alias" "$unit" job
}

water_toggle() {
    local unit="sonar-water-report-${1}.timer"
    if systemctl is-enabled --quiet "$unit"; then
        systemctl disable --now "$unit"
    else
        systemctl enable --now "$unit"
    fi
}

water_status() {
    unit_icon "Отчёты · день" sonar-water-report-daily.timer timer
    unit_icon "Отчёты · неделя" sonar-water-report-weekly.timer timer
    unit_icon "Отчёт · день" sonar-water-report@daily.service job
    unit_icon "Отчёт · неделя" sonar-water-report@weekly.service job
    timer_next "День" sonar-water-report-daily.timer
    timer_next "Неделя" sonar-water-report-weekly.timer
}

network_status() {
    run_status_provider "$status_dir/20-vpn"
    run_status_provider "$status_dir/30-rumyantsevo"
    local route_device
    route_device=$(ip route get 192.168.2.3 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "dev") {print $(i+1); exit}}')
    if [[ -n "$route_device" ]]; then
        printf '✅ Камера: маршрут через %s\n' "$route_device"
    else
        printf '❌ Камера: маршрут не найден\n'
    fi
}

case "${1:-}" in
    status) run_all_statuses ;;
    egg-on)
        systemctl enable --now egg-cam.service
        unit_icon "Яйца" egg-cam.service
        ;;
    egg-off)
        systemctl disable --now egg-cam.service
        unit_icon "Яйца" egg-cam.service
        ;;
    egg-restart)
        systemctl restart egg-cam.service
        unit_icon "Яйца" egg-cam.service
        ;;
    water-status) water_status ;;
    water-daily-toggle) water_toggle daily ;;
    water-weekly-toggle) water_toggle weekly ;;
    water-daily) water_run daily ;;
    water-weekly) water_run weekly ;;
    well-level) run_status_provider "$status_dir/40-well" level ;;
    network-status) network_status ;;
    sstp-restart)
        systemctl restart egg-cam-sstp.service
        unit_icon "Румянцево(SSTP)" egg-cam-sstp.service
        ;;
    adguard-restart)
        systemctl restart egg-cam-adguard.service
        run_status_provider "$status_dir/20-vpn"
        ;;
    *)
        echo "unsupported action" >&2
        exit 2
        ;;
esac
