#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 1 ]] || { echo "exactly one action is required" >&2; exit 2; }
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
status_dir=/etc/tg-server-control/status.d
source /usr/local/lib/tg-server-control/status-common.sh

run_status_provider() {
    local provider="$1"
    shift
    if [[ -x "$provider" ]]; then
        timeout --kill-after=2s 30s "$provider" "$@" || printf '⚠️ Данные временно недоступны\n'
    fi
}

run_all_statuses() {
    local provider
    while IFS= read -r -d '' provider; do
        run_status_provider "$provider"
    done < <(find "$status_dir" -maxdepth 1 -type f -executable -print0 | sort -z)
}

water_run() {
    local period="$1"
    local unit="sonar-water-report@${period}.service"
    report_run "$unit"
}

report_run() {
    local unit="$1"
    systemctl reset-failed "$unit" || true
    if systemctl start "$unit" >/dev/null 2>&1; then
        printf 'Отчёт отправлен\n'
        return
    fi
    if journalctl -u "$unit" -n 30 --no-pager -o cat 2>/dev/null | grep -Eqi 'No valid .*measurements'; then
        printf 'Нет данных\n'
    else
        printf 'Отчёт не сформирован\n'
    fi
    return 1
}

water_toggle() {
    local unit="sonar-water-report-${1}.timer"
    if systemctl is-enabled --quiet "$unit"; then
        systemctl disable --now "$unit"
    else
        systemctl enable --now "$unit"
    fi
}

water_status() {
    timer_schedule "Колодец · сутки" "ежедневно 08:10" sonar-water-report-daily.timer
    timer_schedule "Колодец · 7 дней" "пн 08:15" sonar-water-report-weekly.timer
    timer_schedule "Климат · 7 дней" "пн 08:00" nest-climate-report.timer
}

timer_schedule() {
    local label="$1"
    local schedule="$2"
    local unit="$3"
    local active icon
    active=$(systemctl is-active "$unit" 2>/dev/null || true)
    case "$active" in
        active) icon='✅' ;;
        inactive) icon='⏸' ;;
        *) icon='❌' ;;
    esac
    printf '%s %s: %s\n' "$icon" "$label" "$schedule"
}

nest_temperature() {
    local config=/etc/tg-server-control/nest.env
    if [[ ! -r "$config" ]]; then
        printf '⚠️ 1 этаж: нет данных\n'
        return
    fi
    set -a
    source "$config"
    set +a
    /opt/tg-server-control/venv/bin/python -I \
        /usr/local/lib/tg-server-control/nest_temperature.py
}

nest_climate_status() {
    local config=/etc/tg-server-control/well.env
    if [[ ! -r "$config" ]]; then
        printf '⚠️ 1 этаж: нет данных\n'
        printf '⚠️ 2 этаж: нет данных\n'
        return
    fi
    set -a
    source "$config"
    set +a
    YDB_TABLE=nest_environment_readings \
        /opt/tg-server-control/venv/bin/python -I \
        /usr/local/lib/tg-server-control/nest_climate_status.py
}

network_status() {
    if [[ -x /usr/local/sbin/tg-vpn-failover-status ]]; then
        /usr/local/sbin/tg-vpn-failover-status
        /usr/local/sbin/tg-vpn-failover-status --mtproto
    else
        run_status_provider "$status_dir/20-vpn"
        run_status_provider "$status_dir/25-mtproto"
    fi
    run_status_provider "$status_dir/30-home-tunnel"
}

case "${1:-}" in
    status) run_all_statuses ;;
    egg-on)
        systemctl enable --now egg-cam.service
        unit_icon "Яйца" egg-cam.service
        ;;
    egg-off)
        systemctl disable --now egg-cam.service
        unit_icon "Яйца" egg-cam.service
        ;;
    egg-restart)
        systemctl restart egg-cam.service
        unit_icon "Яйца" egg-cam.service
        ;;
    water-status) water_status ;;
    water-daily-toggle) water_toggle daily ;;
    water-weekly-toggle) water_toggle weekly ;;
    water-daily) water_run daily ;;
    water-weekly) water_run weekly ;;
    climate-weekly) report_run nest-climate-report.service ;;
    well-level) run_status_provider "$status_dir/40-well" level ;;
    nest-temperature) nest_temperature ;;
    nest-climate-status) nest_climate_status ;;
    network-status) network_status ;;
    sstp-restart)
        systemctl restart "$SSTP_UNIT"
        unit_icon "Туннель до дома" "$SSTP_UNIT"
        ;;
    vpn-switch)
        /usr/local/sbin/mtproxy-failover --force-switch
        run_status_provider "$status_dir/20-vpn"
        ;;
    *)
        echo "unsupported action" >&2
        exit 2
        ;;
esac
