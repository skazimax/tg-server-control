[Unit]
Description=Telegram control service for egg-cam host
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=skazimax
Group=skazimax
WorkingDirectory=/home/skazimax/git/tg-server-control
EnvironmentFile=/etc/tg-server-control/bot.env
Environment=PYTHONUNBUFFERED=1
Environment=ALL_PROXY=socks5h://127.0.0.1:1079
Environment=all_proxy=socks5h://127.0.0.1:1079
Environment=NO_PROXY=localhost,127.0.0.1
Environment=no_proxy=localhost,127.0.0.1
ExecStart=/home/skazimax/git/tg-server-control/.venv/bin/python -m tg_server_control.bot
Restart=always
RestartSec=10
TimeoutStopSec=15
PrivateTmp=true

[Install]
WantedBy=multi-user.target
